# Variables the worker reads: the shared runtime ones (plan D-01) and its own.
BATCH_SIZE=100
RUN_TIMEOUT=60s
HTTP_TIMEOUT=5s
HTTP_ATTEMPTS=3
# time between two runs (ADR-004 D10, HU-WRK-008 AC1)
CLOSE_INTERVAL=15m
# where the health endpoint listens
HEALTH_ADDR=:8080
# internal base URL on the platform network: no trailing path, no credentials
CASH_REPORTING_BASE_URL=http://cash-reporting-api:8085
# a SERVICE token issued by multi-tour-security: `security issue-service-token worker-cash-close <duration>`; a secret of
# the environment, never versioned
SERVICE_TOKEN=
